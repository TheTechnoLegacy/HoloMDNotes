<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.techno.holomdnotes">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true">

        <activity
        android:label="@string/app_name"
        android:name="com.techno.holomdnotes.MainActivity">
        <intent-filter >
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

        <activity android:name="com.techno.holomdnotes.SettingsActivity" android:label="Settings" />
        <activity android:name="com.techno.holomdnotes.EditNoteActivity" android:label="Edit note" />
        <activity android:name="com.techno.holomdnotes.ViewNoteActivity" android:label="Note view" />

    </application>
</manifest>
