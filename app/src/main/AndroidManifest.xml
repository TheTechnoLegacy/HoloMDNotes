<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.val00n.mdnotes">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true">

        <activity
        android:label="@string/app_name"
        android:name="com.val00n.mdnotes.MainActivity">
        <intent-filter >
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

        <activity android:name="com.val00n.mdnotes.SettingsActivity" android:label="Settings" />
        <activity android:name="com.val00n.mdnotes.EditNoteActivity" android:label="Edit note" />
        <activity android:name="com.val00n.mdnotes.ViewNoteActivity" android:label="Note view" />

    </application>
</manifest>
